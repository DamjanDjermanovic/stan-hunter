    {
      "id": "0bd7c694-6ef5-44e3-9ae1-ff9d34280b27",
      "name": "GetKnownIds",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "contentType": "json",
        "jsonBody": "={{ { query: \"SELECT ARRAY_AGG(DISTINCT id) AS ids FROM `stan-hunter.stan_hunter.listings` WHERE izvor = 'cityexpert'\", useLegacySql: false, location: 'EU', timeoutMs: 30000 } }}",
        "method": "POST",
        "nodeCredentialType": "googleApi",
        "options": {
          "timeout": 45000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://bigquery.googleapis.com/bigquery/v2/projects/stan-hunter/queries"
      },
      "credentials": {
        "googleApi": {
          "name": "Google Service Account account"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "d43bea37-9af0-4773-bc56-cd165d33dfcc",
      "name": "PrepareFetch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "// Catch-up pagination: the search is sorted newest first, 30 per page. Normally page 1 is enough, but after downtime\n// (laptop off, night pause) more new listings may exist than fit on one page. FetchCityExpert keeps requesting pages\n// until a page contains a listing already in BigQuery (max 5). With allPages = true (Cleanup) it reads every page (max 10).\nlet all = false;\ntry { all = $('Execute Workflow Trigger').first().json.allPages === true; } catch (e) { all = false; }\nconst r = $input.first().json;\nconst cell = r.rows?.[0]?.f?.[0]?.v;\nconst known = Array.isArray(cell) ? cell.map(x => x.v) : [];\nreturn [{ json: { all, known, known_ok: !r.error && Array.isArray(cell) } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    }
  ],
