              "name": "kucni_ljubimci",
              "type": "string",
              "value": "={{ $json.descTags?.petsAllowed === true ? 'da' : ($json.descTags?.petsAllowed === false ? 'ne' : 'nepoznato') }}"
            },
            {
              "id": "z-provizija",
