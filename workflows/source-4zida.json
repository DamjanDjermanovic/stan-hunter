              "value": "={{ $json.createdAt }}"
            },
            {
              "id": "z-slika",
              "name": "slika",
              "type": "string",
              "value": "={{ $json.image?.search?.['840x0_fill_0_jpeg'] ?? '' }}"
            },
            {
              "id": "z-upisano",
              "name": "upisano",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "z-filter",
              "name": "prosao_filter",
              "type": "boolean",
              "value": "={{ $json.roomCount >= 1.5 && ($json.paymentTerm ?? 'month') !== 'day' && ($json.furnished ?? 'nepoznato') !== 'no' && $json.price <= 600 && $json.m2 >= 30 }}"
            },
            {
              "id": "z-depozit",
              "name": "depozit_eur",
              "type": "number",
              "value": "={{ $json.descTags?.deposit ?? null }}"
