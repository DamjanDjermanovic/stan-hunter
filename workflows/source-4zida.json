      "name": "GetKnownIds",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        96
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "contentType": "json",
        "jsonBody": "={{ { query: \"SELECT ARRAY_AGG(DISTINCT id) AS ids FROM `stan-hunter.stan_hunter.listings` WHERE izvor = '4zida'\", useLegacySql: false, location: 'EU', timeoutMs: 30000 } }}",
        "method": "POST",
        "nodeCredentialType": "googleApi",
        "options": {
          "timeout": 45000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://bigquery.googleapis.com/bigquery/v2/projects/stan-hunter/queries"
      },
      "credentials": {
        "googleApi": {
          "name": "Google Service Account account"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "c1e2078c-c26c-411f-8d17-f2bbf49335bd",
      "name": "PrepareFetch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "jsCode": "// Catch-up pagination: the API is sorted newest first. Normally page 1 is enough, but after downtime (laptop off,\n// night pause) more new listings may exist than fit on one page. Fetch4zida keeps requesting pages until a page contains\n// a listing that is already in BigQuery (max 5 pages). With allPages = true (Cleanup) it reads every page (max 10).\nlet all = false;\ntry { all = $('Execute Workflow Trigger').first().json.allPages === true; } catch (e) { all = false; }\nconst r = $input.first().json;\nconst cell = r.rows?.[0]?.f?.[0]?.v;\nconst known = Array.isArray(cell) ? cell.map(x => x.v) : [];\nreturn [{ json: { all, known, known_ok: !r.error && Array.isArray(cell) } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      }
    }
  ],
