            },
            {
              "name": "placeIds",
              "value": "213"
            }
          ]
        },
        "options": {
          "queryParameterArrays": "brackets",
          "timeout": 15000,
          "pagination": {
            "pagination": {
              "completeExpression": "={{ (() => { const ads = $response.body.ads || []; return ads.length < 20 || (!$json.all && ads.some(a => $json.known.includes('4zida_' + a.id))); })() }}",
              "limitPagesFetched": true,
              "maxRequests": "={{ $json.all ? 10 : 5 }}",
              "paginationCompleteWhen": "other",
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "name": "page",
                    "type": "qs",
                    "value": "={{ $pageCount + 1 }}"
                  }
                ]
              },
              "requestInterval": 1000
