    {
      "id": "c0a7c5a0-161f-4d22-afa2-c177502ebd44",
      "name": "ExtractHaloFields",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "card",
        "extractionValues": {
          "values": [
            {
              "key": "href",
              "cssSelector": "h3.product-title a",
              "returnValue": "attribute",
              "attribute": "href",
              "returnArray": false
            },
            {
              "key": "naslov",
              "cssSelector": "h3.product-title a",
              "returnValue": "text",
              "returnArray": false
            },
            {
              "key": "cena",
              "cssSelector": ".central-feature span",
              "returnValue": "attribute",
              "attribute": "data-value",
              "returnArray": false
            },
            {
              "key": "features",
              "cssSelector": ".product-features .value-wrapper",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "mesta",
              "cssSelector": ".subtitle-places li",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "slika",
              "cssSelector": "figure img",
              "returnValue": "attribute",
              "attribute": "src",
              "returnArray": false
            },
            {
              "key": "datum",
              "cssSelector": ".publish-date",
              "returnValue": "text",
              "returnArray": false
