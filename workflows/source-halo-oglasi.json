    {
      "id": "539557bf-554b-4822-a92b-746a7b184fb6",
      "name": "FormatHalo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "h-id",
              "name": "id",
              "value": "=halo_{{ $json.href.split('?')[0].split('/').pop() }}",
              "type": "string"
            },
            {
              "id": "h-izvor",
              "name": "izvor",
              "value": "halooglasi",
              "type": "string"
            },
            {
              "id": "h-url",
              "name": "url",
              "value": "=https://www.halooglasi.com{{ $json.href.split('?')[0] }}",
              "type": "string"
            },
            {
              "id": "h-naslov",
              "name": "naslov",
              "value": "={{ $json.naslov }}",
              "type": "string"
            },
            {
              "id": "h-cena",
              "name": "cena",
              "value": "={{ parseInt(String($json.cena ?? '').replace(/\\./g, '')) || null }}",
              "type": "number"
            },
            {
              "id": "h-m2",
              "name": "m2",
              "value": "={{ parseFloat(($json.features ?? []).find(f => f.includes('Kvadratura')) ?? '') || null }}",
              "type": "number"
            },
            {
              "id": "h-sobe",
              "name": "sobe",
              "value": "={{ parseFloat(($json.features ?? []).find(f => f.includes('Broj soba')) ?? '') || null }}",
              "type": "number"
            },
            {
              "id": "h-opstina",
              "name": "opstina",
              "value": "={{ ($json.mesta?.[1] ?? '').replace(/^Opština\\s*/, '') }}",
              "type": "string"
            },
            {
              "id": "h-naselje",
              "name": "naselje",
              "value": "={{ $json.mesta?.[2] ?? '' }}",
              "type": "string"
            },
            {
              "id": "h-namesten",
              "name": "namesten",
              "value": "nepoznato",
              "type": "string"
            },
            {
              "id": "h-placanje",
              "name": "placanje",
              "value": "month",
              "type": "string"
            },
            {
              "id": "h-objavljeno",
              "name": "objavljeno",
              "value": "={{ $json.datum ? DateTime.fromFormat($json.datum.replace(/\\.$/, ''), 'dd.MM.yyyy', { zone: 'Europe/Belgrade' }).toISO() : null }}",
              "type": "string"
            },
            {
              "id": "h-slika",
              "name": "slika",
              "value": "={{ $json.slika ?? '' }}",
              "type": "string"
            },
            {
              "id": "h-upisano",
              "name": "upisano",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "h-filter",
              "name": "prosao_filter",
              "value": "={{ (() => { const c = parseInt(String($json.cena ?? '').replace(/\\./g, '')); const m = parseFloat(($json.features ?? []).find(f => f.includes('Kvadratura')) ?? ''); const s = parseFloat(($json.features ?? []).find(f => f.includes('Broj soba')) ?? ''); return c > 0 && c <= 500 && m >= 30 && (isNaN(s) || s >= 1.5); })() }}",
              "type": "boolean"
            }
          ]
        },
        "options": {}
      }
    },
